  fileUrl       String?
  exportedById  String
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
  institution   Institution  @relation(fields: [institutionId], references: [id])
  subject       Subject      @relation(fields: [subjectId], references: [id])
}

model SimilarityCheckResult {
  id                   String                      @id @default(cuid())
  submissionId         String                      @unique
  checkScore           Int
  matchedSubmissionIds String[]                    @default([])
  checkedAt            DateTime                    @default(now())
  flagged              Boolean                     @default(false)
  submission           SubjectAssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model LeadLabel {
  id            String      @id @default(cuid())
  institutionId String
  name          String
  color         String      @default("#6366f1")
  leads         Lead[]
  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, name])
}

model Lead {
  id                   String         @id @default(cuid())
  institutionId        String
  name                 String
  phone                String
  email                String?
  status               LeadStatus     @default(NEW)
  notes                String?
  assignedToId         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  convertedAdmissionId String?
  labelId              String?
  targetClassId        String?
  source               LeadSource     @default(WALK_IN)
  assignedTo           Staff?         @relation(fields: [assignedToId], references: [id])
  institution          Institution    @relation(fields: [institutionId], references: [id])
  label                LeadLabel?     @relation(fields: [labelId], references: [id])
  targetClass          ClassTemplate? @relation(fields: [targetClassId], references: [id])
  followUps            LeadFollowUp[]

  @@index([institutionId, status])
  @@index([institutionId, source])
  @@index([institutionId, assignedToId])
}

model LeadFollowUp {
  id            String          @id @default(cuid())
  leadId        String
  channel       FollowUpChannel
  scheduledAt   DateTime
  completedAt   DateTime?
  notes         String?
  outcome       String?
  createdAt     DateTime        @default(now())
  institutionId String
  staffId       String
  institution   Institution     @relation(fields: [institutionId], references: [id])
  lead          Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staff         Staff           @relation(fields: [staffId], references: [id])

  @@index([institutionId, staffId, scheduledAt])
  @@index([leadId])
}

model MeritListConfig {
  id              String           @id @default(cuid())
  institutionId   String
  name            String
  academicYearId  String
  totalSeats      Int
  cutoffScore     Float?
  rankingCriteria Json
  createdAt       DateTime         @default(now())
  publishedAt     DateTime?
  targetClassId   String
  updatedAt       DateTime         @updatedAt
  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id])
  institution     Institution      @relation(fields: [institutionId], references: [id])
  targetClass     ClassTemplate    @relation(fields: [targetClassId], references: [id])
  entries         MeritListEntry[]

  @@unique([institutionId, targetClassId, academicYearId])
}

model MeritListEntry {
  id          String           @id @default(cuid())
  rank        Int
  status      MeritEntryStatus @default(WAITLISTED)
  admissionId String
  meritListId String
  notifiedAt  DateTime?
  score       Float
  admission   Admission        @relation(fields: [admissionId], references: [id])
