generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id              String    @id @default(cuid())
  name            String
  subdomain       String    @unique
  primaryColor    String    @default("#1d4ed8")
  logoUrl         String?
  planTier        PlanTier  @default(STARTER)
  board           Board     @default(CBSE)
  isActive        Boolean   @default(true)
  suspendedAt     DateTime?
  suspendedReason String?
  billingEmail    String?
  customPricing   Decimal?  @db.Decimal(10, 2)

  // White labeling
  secondaryColor String?
  themePalette   Json?
  darkPalette    Json?
  squareLogoUrl  String?
  faviconUrl     String?
  emailHeader    String?
  themeAppliedAt DateTime?

  // Additional details
  institutionType InstitutionType @default(SCHOOL)
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  pinCode         String?
  phone           String?
  website         String?
  establishedYear Int?
  studentCapacity Int?

  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  users             User[]
  students          Student[]
  roles             Role[]
  onboarding        OnboardingStep?
  documents         Document[]
  calendarEvents    SchoolCalendarEvent[]
  tickets           SupportTicket[]
  communicationLogs ParentCommunicationLog[]

  admissionSettings   AdmissionSettings?
  documentTypeConfigs DocumentTypeConfig[]
  inquiries           Inquiry[]
  admissions          Admission[]
  behaviourIncidents  BehaviourIncident[]
  achievements        Achievement[]
  counsellorNotes     CounsellorNote[]

  // New relations
  classTemplates     ClassTemplate[]
  classYears         ClassYear[]
  sections           Section[]
  studentSections    StudentSection[]
  subjects           Subject[]
  subjectPosts       SubjectPost[]
  examTypes          ExamType[]
  gradeEntries       GradeEntry[]
  attendance         Attendance[]
  attendanceSettings AttendanceSettings?
  timetableSlots     TimetableSlot[]
  homeworkLogs       HomeworkLog[]
  lessonPlans        LessonPlan[]
  examSchedules      ExamSchedule[]
  substitutions      SubstitutionRecord[]
  courses            Course[]
  promotionRecords   PromotionRecord[]

  // Staff module relations
  departments              Department[]
  staffRoles               StaffRole[]
  staff                    Staff[]
  staffLeaveTypes          StaffLeaveType[]
  staffLeaves              StaffLeave[]
  staffAttendance          StaffAttendance[]
  staffSalaries            StaffSalary[]
  staffDocuments           StaffDocument[]
  performanceNotes         PerformanceNote[]
  classTeacherAssignments  ClassTeacherAssignment[]
  staffSettings            StaffSettings?
  staffSalaryConfig        StaffSalaryConfig?

  // Fee module relations
  feeCategories            FeeCategory[]
  feePayments              FeePayment[]
  feeFines                 FeeFine[]
  feeReminders             FeeReminder[]
  feeConcessions           FeeConcession[]
  feeSettings              FeeSettings?

  // Notifications
  notifications            Notification[]
  notificationTemplates    NotificationTemplate[]
  notificationPreferences  NotificationPreference[]
}

model User {
  id             String           @id @default(cuid())
  institutionId  String
  institution    Institution      @relation(fields: [institutionId], references: [id])
  email          String
  hashedPassword String
  portalType     PortalType
  isActive       Boolean          @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime         @default(now())
  subjectTeacher SubjectTeacher[]
  staff          Staff?

  // Notifications
  notifications          Notification[]
  notificationPreference NotificationPreference?

  @@unique([institutionId, email])
}

model Student {
  id            String      @id @default(cuid())
  serialNo      Int         @unique @default(autoincrement())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  userId        String?     @unique
  admissionId   String?     @unique
  admission     Admission?  @relation(fields: [admissionId], references: [id])
  admissionNo   String
  sisId         String      @unique
  rollNo        String?
  firstName     String
  middleName    String?
  lastName      String
  dateOfBirth   DateTime
  gender        Gender
  bloodGroup    String?
  nationality   String?
  religion      String?
  motherTongue  String?
  photoUrl      String?

  // ID proof
  idProofType   String?
  idProofNumber String?

  guardianName  String
  guardianPhone String
  status        StudentStatus @default(ACTIVE)

  // Health
  allergies            String[] @default([])
  medicalConditions    Json     @default("[]")
  emergencyDoctorName  String?
  emergencyDoctorPhone String?

  // Transport
  transportMode TransportMode @default(DAY_SCHOLAR)
  busRouteId    String?
  pickupStop    String?
  dropStop      String?
  boardingType  BoardingType  @default(DAY_SCHOLAR)
  hostelRoom    String?

  createdAt DateTime @default(now())

  // Relations
  guardians       Guardian[]
  documents       StudentDocument[]
  idCards         StudentIdCard[]
  siblings        StudentSibling[]    @relation("StudentSiblings")
  siblingOf       StudentSibling[]    @relation("SiblingOf")
  exit            StudentExit?
  incidents       BehaviourIncident[]
  achievements    Achievement[]
  counsellorNotes CounsellorNote[]

  // New relations
  sections          StudentSection[]
  promotions        PromotionRecord[]
  attendance        Attendance[]
  gradeEntries      GradeEntry[]
  submissions       AssignmentSubmission[]
  quizAttempts      QuizAttempt[]
  pollVotes         PollVote[]
  homework          HomeworkCompletion[]
  courseEnrollments CourseEnrollment[]
  feePayments      FeePayment[]
  feeConcessions   FeeConcession[]

  @@unique([institutionId, admissionNo])
}

model AcademicYear {
  id            String      @id @default(cuid())
  institutionId String
  name          String
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean     @default(false)
  classYears    ClassYear[]
  classTeacherAssignments ClassTeacherAssignment[]
}

model FeeCategory {
  id              String         @id @default(cuid())
  institutionId   String
  name            String
  description     String?
  amount          Decimal        @db.Decimal(12, 2)
  frequency       FeeFrequency   @default(MONTHLY)
  isOptional      Boolean        @default(false)
  applicableTo    FeeApplicable  @default(ALL)
  classYearIds    String[]       @default([])
  sectionIds      String[]       @default([])
  isActive        Boolean        @default(true)
  order           Int            @default(0)
  createdAt       DateTime       @default(now())
  institution     Institution    @relation(fields: [institutionId], references: [id])
  payments        FeePayment[]
  reminders       FeeReminder[]

  @@unique([institutionId, name])
}

enum FeeFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  ONE_TIME
}

enum FeeApplicable {
  ALL
  CLASS
  SECTION
}

model FeePayment {
  id              String           @id @default(cuid())
  institutionId   String
  studentId       String
  feeCategoryId   String
  amount          Decimal          @db.Decimal(12, 2)
  fineAmount      Decimal          @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal          @db.Decimal(12, 2)
  status          FeePaymentStatus @default(PENDING)
  method          PaymentMethod?
  receiptNo       String?          @unique
  transactionRef  String?
  dueDate         DateTime         @db.Date
  paidAt          DateTime?
  month           Int?
  year            Int?
  notes           String?
  collectedById   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  institution     Institution      @relation(fields: [institutionId], references: [id])
  student         Student          @relation(fields: [studentId], references: [id])
  feeCategory     FeeCategory      @relation(fields: [feeCategoryId], references: [id])

  @@unique([studentId, feeCategoryId, month, year])
}

enum FeePaymentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
  PARTIAL
}

model FeeFine {
  id              String      @id @default(cuid())
  institutionId   String
  feeCategoryId   String?
  name            String
  type            FineType    @default(FIXED)
  amount          Decimal     @db.Decimal(10, 2)
  graceDays       Int         @default(0)
  maxAmount       Decimal?    @db.Decimal(10, 2)
  isActive        Boolean     @default(true)
  institution     Institution @relation(fields: [institutionId], references: [id])
}

enum FineType {
  FIXED
  PERCENTAGE
  PER_DAY
}

model FeeReminder {
  id              String       @id @default(cuid())
  institutionId   String
  feeCategoryId   String?
  daysBeforeDue   Int
  channel         String
  messageTemplate String
  isActive        Boolean      @default(true)
  institution     Institution  @relation(fields: [institutionId], references: [id])
  feeCategory     FeeCategory? @relation(fields: [feeCategoryId], references: [id])
}

model FeeConcession {
  id              String         @id @default(cuid())
  institutionId   String
  studentId       String
  feeCategoryId   String?
  name            String
  type            ConcessionType
  amount          Decimal        @db.Decimal(10, 2)
  validFrom       DateTime       @db.Date
  validTill       DateTime?      @db.Date
  approvedById    String
  notes           String?
  createdAt       DateTime       @default(now())
  institution     Institution    @relation(fields: [institutionId], references: [id])
  student         Student        @relation(fields: [studentId], references: [id])
}

enum ConcessionType {
  FIXED
  PERCENTAGE
}

model FeeSettings {
  id                    String      @id @default(cuid())
  institutionId         String      @unique
  receiptPrefix         String      @default("RCP")
  receiptCurrentSeq     Int         @default(1001)
  lateFineEnabled       Boolean     @default(false)
  reminderEnabled       Boolean     @default(false)
  partialPaymentAllowed Boolean     @default(true)
  institution           Institution @relation(fields: [institutionId], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  institutionId String
  userId        String
  action        String
  tableName     String
  recordId      String
  before        Json?
  after         Json?
  createdAt     DateTime @default(now())
}

model Role {
  id             String         @id @default(cuid())
  institutionId  String
  name           String
  isSystemRole   Boolean        @default(false)
  permissions    Json           @default("[]")
  masqueradeMode MasqueradeMode @default(READ_ONLY)
  createdAt      DateTime       @default(now())
  institution    Institution    @relation(fields: [institutionId], references: [id])
}

enum MasqueradeMode {
  READ_ONLY
  FULL_ACCESS
  DISABLED
}

enum PlanTier {
  STARTER
  GROWTH
  PRO
}

enum Board {
  CBSE
  ICSE
  STATE
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  TRAINING_CENTER
}

enum PortalType {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
  INSTRUCTOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  EXCUSED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  CHEQUE
  NEFT
  RTGS
  DD
}

enum DocumentType {
  TRANSFER_CERTIFICATE
  ADMISSION_FORM
  MARKSHEET
  ID_PROOF
  MEDICAL_RECORD
  STAFF_CONTRACT
  OTHER
}

enum CalendarEventType {
  HOLIDAY
  EXAM
  EVENT
  MEETING
  DEADLINE
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum NotificationType {
  ANNOUNCEMENT
  FEE_DUE
  FEE_PAID
  FEE_OVERDUE
  ATTENDANCE_ABSENT
  ATTENDANCE_SUMMARY
  GRADE_PUBLISHED
  ASSIGNMENT_DUE
  QUIZ_AVAILABLE
  HOMEWORK_ASSIGNED
  LEAVE_APPROVED
  LEAVE_REJECTED
  SUBSTITUTION
  GENERAL
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AdmissionStatus {
  INQUIRY
  APPLIED
  ADMITTED
  ENROLLED
  REJECTED
}

enum AdmissionType {
  NEW
  TRANSFER
}

enum GuardianType {
  FATHER
  MOTHER
  GUARDIAN
}

enum InquirySource {
  WALK_IN
  PHONE
  WEBSITE
  REFERRAL
  OTHER
}

enum TransportMode {
  DAY_SCHOLAR
  BUS
  PARENT_DROP
  WALK
  OTHER
}

enum BoardingType {
  DAY_SCHOLAR
  BOARDER
}

model OnboardingStep {
  id            String      @id @default(cuid())
  institutionId String      @unique
  institution   Institution @relation(fields: [institutionId], references: [id])
  classesAdded  Boolean     @default(false)
  staffAdded    Boolean     @default(false)
  studentsAdded Boolean     @default(false)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
}

model Document {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  studentId     String?
  staffId       String?
  uploadedById  String
  name          String
  type          DocumentType
  fileUrl       String
  fileSize      Int
  mimeType      String
  isVerified    Boolean      @default(false)
  createdAt     DateTime     @default(now())
}

model SchoolCalendarEvent {
  id            String            @id @default(cuid())
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id])
  title         String
  description   String?
  type          CalendarEventType
  startDate     DateTime
  endDate       DateTime
  isHoliday     Boolean           @default(false)
  createdById   String
  createdAt     DateTime          @default(now())
}

model SupportTicket {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id])
  raisedById    String
  title         String
  description   String
  priority      TicketPriority  @default(MEDIUM)
  status        TicketStatus    @default(OPEN)
  resolvedById  String?
  resolvedAt    DateTime?
  messages      TicketMessage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  authorId   String
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
}

model ParentCommunicationLog {
  id            String              @id @default(cuid())
  institutionId String
  institution   Institution         @relation(fields: [institutionId], references: [id])
  studentId     String
  sentById      String
  channel       NotificationChannel
  subject       String?
  body          String
  status        NotificationStatus  @default(SENT)
  sentAt        DateTime            @default(now())
}

model PlatformRole {
  id             String         @id @default(cuid())
  name           String         @unique
  description    String?
  permissions    Json           @default("[]")
  masqueradeMode MasqueradeMode @default(DISABLED)
  isSystemRole   Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  users          PlatformUser[]
}

model PlatformUser {
  id             String       @id @default(cuid())
  email          String       @unique
  hashedPassword String
  platformRoleId String
  platformRole   PlatformRole @relation(fields: [platformRoleId], references: [id])
  isActive       Boolean      @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
}

// ─── Admissions Module ───

model AdmissionSettings {
  id                    String      @id @default(cuid())
  institutionId         String      @unique
  institution           Institution @relation(fields: [institutionId], references: [id])
  admissionNoPrefix     String      @default("ADM")
  admissionNoCurrentSeq Int         @default(1001)
  rollNoPrefix          String      @default("")
  rollNoCurrentSeq      Int         @default(1)
  appNoPrefix           String      @default("APP")
  appNoCurrentSeq       Int         @default(1)
  acceptedIdProofTypes  String[]    @default(["AADHAAR"])
  customFormFields      Json        @default("[]")
  exitDocumentTypes     Json        @default("[]")
  onDemandDocumentTypes Json        @default("[]")
  idCardValidTill       DateTime?
}

model DocumentTypeConfig {
  id              String      @id @default(cuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id])
  name            String
  isRequired      Boolean     @default(false)
  acceptedFormats String[]    @default(["PDF", "JPEG", "PNG"])
  showInAdmission Boolean     @default(true)
  showInProfile   Boolean     @default(true)
  order           Int         @default(0)

  studentDocuments StudentDocument[]

  @@unique([institutionId, name])
}

model Inquiry {
  id                     String        @id @default(cuid())
  institutionId          String
  institution            Institution   @relation(fields: [institutionId], references: [id])
  name                   String
  phone                  String
  email                  String?
  source                 InquirySource @default(WALK_IN)
  notes                  String?
  convertedToAdmissionId String?
  createdById            String
  createdAt              DateTime      @default(now())
}

model Admission {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id])
  applicationNo String          @unique
  admissionNo   String?         @unique
  status        AdmissionStatus @default(APPLIED)

  // Personal
  firstName    String
  middleName   String?
  lastName     String
  dateOfBirth  DateTime
  gender       Gender
  bloodGroup   String?
  nationality  String?
  religion     String?
  motherTongue String?
  photoUrl     String?

  // ID Proof
  idProofType   String?
  idProofNumber String?
  idProofDocUrl String?

  // Admission details
  admissionType      AdmissionType @default(NEW)
  previousSchoolName String?
  previousClass      String?
  previousTCNumber   String?

  // Class (optional at admission)
  classId        String?
  sectionId      String?
  academicYearId String

  // Meta
  customFieldValues Json      @default("{}")
  appliedAt         DateTime  @default(now())
  admittedAt        DateTime?
  enrolledAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  createdById       String

  // Relations
  guardians Guardian[]
  documents StudentDocument[]
  student   Student?
}

model Guardian {
  id             String       @id @default(cuid())
  admissionId    String?
  admission      Admission?   @relation(fields: [admissionId], references: [id])
  studentId      String?
  student        Student?     @relation(fields: [studentId], references: [id])
  type           GuardianType
  relationship   String?
  name           String
  phone          String
  alternatePhone String?
  email          String?
  occupation     String?
  annualIncome   Decimal?     @db.Decimal(12, 2)
  idProofType    String?
  idProofNumber  String?

  isEmergencyContact Boolean @default(false)
  isPrimaryContact   Boolean @default(false)
  canLogin           Boolean @default(false)
  userId             String? @unique
}

model StudentDocument {
  id                   String              @id @default(cuid())
  institutionId        String
  studentId            String?
  student              Student?            @relation(fields: [studentId], references: [id])
  admissionId          String?
  admission            Admission?          @relation(fields: [admissionId], references: [id])
  documentTypeConfigId String?
  documentTypeConfig   DocumentTypeConfig? @relation(fields: [documentTypeConfigId], references: [id])
  documentTypeName     String
  fileUrl              String
  fileName             String
  fileSize             Int?
  mimeType             String?
  isVerified           Boolean             @default(false)
  verifiedById         String?
  verifiedAt           DateTime?
  uploadedById         String
  notes                String?
  createdAt            DateTime            @default(now())
}

model StudentIdCard {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  issuedById String
  issuedAt   DateTime @default(now())
  validTill  DateTime
  fileUrl    String?
  isActive   Boolean  @default(true)
}

model StudentSibling {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation("StudentSiblings", fields: [studentId], references: [id])
  siblingId String
  sibling   Student @relation("SiblingOf", fields: [siblingId], references: [id])

  @@unique([studentId, siblingId])
}

model StudentExit {
  id                String   @id @default(cuid())
  studentId         String   @unique
  student           Student  @relation(fields: [studentId], references: [id])
  exitType          ExitType
  exitDate          DateTime
  destinationSchool String?
  reason            String?
  processedById     String
  createdAt         DateTime @default(now())
}

enum ExitType {
  TRANSFER
  GRADUATED
  WITHDRAWN
  OTHER
}

// ── Behaviour & Activity ──

model BehaviourIncident {
  id             String           @id @default(cuid())
  institutionId  String
  institution    Institution      @relation(fields: [institutionId], references: [id])
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  type           IncidentType
  date           DateTime         @db.Date
  description    String
  actionTaken    String?
  severity       IncidentSeverity
  reportedById   String
  parentNotified Boolean          @default(false)
  createdAt      DateTime         @default(now())
}

model Achievement {
  id            String              @id @default(cuid())
  institutionId String
  institution   Institution         @relation(fields: [institutionId], references: [id])
  studentId     String
  student       Student             @relation(fields: [studentId], references: [id])
  category      AchievementCategory
  title         String
  description   String?
  date          DateTime            @db.Date
  awardedById   String
  photoUrl      String?
  createdAt     DateTime            @default(now())
}

model CounsellorNote {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  note          String
  followUpDate  DateTime?
  createdById   String
  createdAt     DateTime    @default(now())
}

enum IncidentType {
  LATE_ARRIVAL
  RULE_VIOLATION
  FIGHT
  OTHER
}

enum IncidentSeverity {
  MINOR
  MODERATE
  SERIOUS
}

enum AchievementCategory {
  SPORTS
  CULTURAL
  ACADEMIC
  COMMUNITY
  OTHER
}

// ─── Class Structure ───

model ClassTemplate {
  id            String      @id @default(cuid())
  institutionId String
  name          String
  gradeLevel    Int
  description   String?
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  classYears    ClassYear[]

  @@unique([institutionId, name])
}

model ClassYear {
  id              String            @id @default(cuid())
  institutionId   String
  classTemplateId String
  academicYearId  String
  status          ClassYearStatus   @default(ACTIVE)
  clonedFromId    String?
  createdAt       DateTime          @default(now())
  institution     Institution       @relation(fields: [institutionId], references: [id])
  classTemplate   ClassTemplate     @relation(fields: [classTemplateId], references: [id])
  academicYear    AcademicYear      @relation(fields: [academicYearId], references: [id])
  sections        Section[]
  subjects        Subject[]
  promotionsFrom  PromotionRecord[] @relation("FromClassYear")
  promotionsTo    PromotionRecord[] @relation("ToClassYear")
  examSchedules   ExamSchedule[]
  studentSections StudentSection[]

  @@unique([classTemplateId, academicYearId])
}

enum ClassYearStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

model Section {
  id             String               @id @default(cuid())
  institutionId  String
  classYearId    String
  name           String
  maxStrength    Int?
  classTeacherId String?
  createdAt      DateTime             @default(now())
  institution    Institution          @relation(fields: [institutionId], references: [id])
  classYear      ClassYear            @relation(fields: [classYearId], references: [id])
  students       StudentSection[]
  attendance     Attendance[]
  timetableSlots TimetableSlot[]
  substitutions  SubstitutionRecord[]
  subjects       Subject[]
  classTeacherAssignments ClassTeacherAssignment[]

  @@unique([classYearId, name])
}

model StudentSection {
  id            String               @id @default(cuid())
  institutionId String
  studentId     String
  sectionId     String
  classYearId   String
  enrolledAt    DateTime             @default(now())
  promotedAt    DateTime?
  status        StudentSectionStatus @default(ACTIVE)
  institution   Institution          @relation(fields: [institutionId], references: [id])
  student       Student              @relation(fields: [studentId], references: [id])
  section       Section              @relation(fields: [sectionId], references: [id])
  classYear     ClassYear            @relation(fields: [classYearId], references: [id])

  @@unique([studentId, classYearId])
}

enum StudentSectionStatus {
  ACTIVE
  PROMOTED
  DETAINED
  TRANSFERRED
  GRADUATED
}

model PromotionRecord {
  id              String          @id @default(cuid())
  institutionId   String
  studentId       String
  fromClassYearId String
  fromSectionId   String
  toClassYearId   String?
  toSectionId     String?
  status          PromotionStatus
  promotedById    String
  promotedAt      DateTime        @default(now())
  notes           String?
  institution     Institution     @relation(fields: [institutionId], references: [id])
  student         Student         @relation(fields: [studentId], references: [id])
  fromClassYear   ClassYear       @relation("FromClassYear", fields: [fromClassYearId], references: [id])
  toClassYear     ClassYear?      @relation("ToClassYear", fields: [toClassYearId], references: [id])
}

enum PromotionStatus {
  PROMOTED
  DETAINED
  TRANSFERRED
  GRADUATED
}

// ─── Subject (unified campus + LMS) ───

model Subject {
  id               String           @id @default(cuid())
  institutionId    String
  classYearId      String
  sectionId        String?
  name             String
  code             String?
  weeklyPeriods    Int              @default(5)
  hasOnlineContent Boolean          @default(false)
  canPreviewFiles  Boolean          @default(true)
  canDownloadFiles Boolean          @default(false)
  createdAt        DateTime         @default(now())
  institution      Institution      @relation(fields: [institutionId], references: [id])
  classYear        ClassYear        @relation(fields: [classYearId], references: [id])
  section          Section?         @relation(fields: [sectionId], references: [id])
  teachers         SubjectTeacher[]
  posts            SubjectPost[]
  gradeEntries     GradeEntry[]
  lessonPlans      LessonPlan[]
  examSchedules    ExamSchedule[]
  timetableSlots   TimetableSlot[]
  homeworkLogs     HomeworkLog[]

  @@unique([classYearId, sectionId, name])
}

model SubjectTeacher {
  id        String  @id @default(cuid())
  subjectId String
  teacherId String
  staffId   String?
  isPrimary Boolean @default(true)
  subject   Subject @relation(fields: [subjectId], references: [id])
  user      User    @relation(fields: [teacherId], references: [id])
  staff     Staff?  @relation(fields: [staffId], references: [id])

  @@unique([subjectId, teacherId])
}

// ─── Subject Posts (stream content) ───

model SubjectPost {
  id            String              @id @default(cuid())
  institutionId String
  subjectId     String
  sectionId     String?
  type          SubjectPostType
  title         String
  description   String?
  scheduledAt   DateTime?
  isPublished   Boolean             @default(true)
  canPreview    Boolean             @default(true)
  canDownload   Boolean             @default(false)
  order         Int                 @default(0)
  topicTag      String?
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  institution   Institution         @relation(fields: [institutionId], references: [id])
  subject       Subject             @relation(fields: [subjectId], references: [id])
  attachments   SubjectAttachment[]
  assignment    Assignment?
  quiz          Quiz?
  poll          Poll?
  homeworkLogs  HomeworkLog[]
}

enum SubjectPostType {
  MATERIAL
  ASSIGNMENT
  QUIZ
  POLL
  EXAM
  ANNOUNCEMENT
  HOMEWORK
}

model SubjectAttachment {
  id            String         @id @default(cuid())
  subjectPostId String
  type          AttachmentType
  url           String
  fileName      String?
  fileSize      Int?
  mimeType      String?
  canPreview    Boolean        @default(true)
  canDownload   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  subjectPost   SubjectPost    @relation(fields: [subjectPostId], references: [id])
}

enum AttachmentType {
  FILE
  VIDEO
  LINK
  IMAGE
}

// ─── Assignments ───

model Assignment {
  id                  String                 @id @default(cuid())
  subjectPostId       String                 @unique
  dueDate             DateTime
  totalMarks          Int                    @default(100)
  allowLateSubmission Boolean                @default(false)
  instructions        String?
  subjectPost         SubjectPost            @relation(fields: [subjectPostId], references: [id])
  submissions         AssignmentSubmission[]
}

model AssignmentSubmission {
  id            String           @id @default(cuid())
  assignmentId  String
  studentId     String
  fileUrl       String?
  notes         String?
  submittedAt   DateTime         @default(now())
  isLate        Boolean          @default(false)
  marksObtained Decimal?         @db.Decimal(5, 2)
  feedback      String?
  gradedById    String?
  gradedAt      DateTime?
  status        SubmissionStatus @default(SUBMITTED)
  assignment    Assignment       @relation(fields: [assignmentId], references: [id])
  student       Student          @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RETURNED
  MISSING
}

// ─── Quizzes ───

model Quiz {
  id               String         @id @default(cuid())
  subjectPostId    String         @unique
  totalMarks       Int            @default(100)
  timeLimit        Int?
  shuffleQuestions Boolean        @default(false)
  showResultsAfter Boolean        @default(true)
  attemptsAllowed  Int            @default(1)
  subjectPost      SubjectPost    @relation(fields: [subjectPostId], references: [id])
  questions        QuizQuestion[]
  attempts         QuizAttempt[]
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  type          QuestionType
  text          String
  options       Json         @default("[]")
  correctAnswer String?
  marks         Int          @default(1)
  order         Int          @default(0)
  explanation   String?
  quiz          Quiz         @relation(fields: [quizId], references: [id])
}

enum QuestionType {
  MCQ
  MULTI_SELECT
  SHORT
  LONG
  TRUE_FALSE
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  studentId   String
  answers     Json      @default("{}")
  score       Decimal?  @db.Decimal(5, 2)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  timeTaken   Int?
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  student     Student   @relation(fields: [studentId], references: [id])

  @@unique([quizId, studentId])
}

// ─── Polls ───

model Poll {
  id            String      @id @default(cuid())
  subjectPostId String      @unique
  question      String
  options       Json        @default("[]")
  allowMultiple Boolean     @default(false)
  closedAt      DateTime?
  subjectPost   SubjectPost @relation(fields: [subjectPostId], references: [id])
  votes         PollVote[]
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  studentId String
  optionIds Json     @default("[]")
  votedAt   DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([pollId, studentId])
}

// ─── Gradebook ───

model ExamType {
  id                String         @id @default(cuid())
  institutionId     String
  name              String
  shortName         String
  countInFinalGrade Boolean        @default(true)
  weightage         Int            @default(0)
  order             Int            @default(0)
  institution       Institution    @relation(fields: [institutionId], references: [id])
  gradeEntries      GradeEntry[]
  examSchedules     ExamSchedule[]

  @@unique([institutionId, name])
}

model GradeEntry {
  id                String      @id @default(cuid())
  institutionId     String
  studentId         String
  subjectId         String
  examTypeId        String
  source            GradeSource @default(MANUAL)
  sourceId          String?
  marksObtained     Decimal     @db.Decimal(5, 2)
  totalMarks        Decimal     @db.Decimal(5, 2)
  gradeLetter       String?
  isIncludedInFinal Boolean     @default(true)
  notes             String?
  enteredById       String
  overriddenById    String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  institution       Institution @relation(fields: [institutionId], references: [id])
  student           Student     @relation(fields: [studentId], references: [id])
  subject           Subject     @relation(fields: [subjectId], references: [id])
  examType          ExamType    @relation(fields: [examTypeId], references: [id])

  @@unique([studentId, subjectId, examTypeId])
}

enum GradeSource {
  MANUAL
  ASSIGNMENT
  QUIZ
}

// ─── Attendance (updated) ───

model AttendanceSettings {
  id            String         @id @default(cuid())
  institutionId String         @unique
  mode          AttendanceMode @default(DAILY)
  institution   Institution    @relation(fields: [institutionId], references: [id])
}

enum AttendanceMode {
  DAILY
  PERIOD
  BOTH
}

model Attendance {
  id            String           @id @default(cuid())
  institutionId String
  studentId     String
  sectionId     String
  subjectId     String?
  date          DateTime         @db.Date
  periodNumber  Int?
  status        AttendanceStatus
  notes         String?
  markedById    String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  institution   Institution      @relation(fields: [institutionId], references: [id])
  student       Student          @relation(fields: [studentId], references: [id])
  section       Section          @relation(fields: [sectionId], references: [id])

  @@unique([studentId, sectionId, date, periodNumber])
}

// ─── Timetable ───

model TimetableSlot {
  id            String      @id @default(cuid())
  institutionId String
  sectionId     String
  subjectId     String
  dayOfWeek     Int
  periodNumber  Int
  startTime     String
  endTime       String
  roomNumber    String?
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  section       Section     @relation(fields: [sectionId], references: [id])
  subject       Subject     @relation(fields: [subjectId], references: [id])

  @@unique([sectionId, dayOfWeek, periodNumber])
}

// ─── Homework + Lesson Plan ───

model HomeworkLog {
  id            String               @id @default(cuid())
  institutionId String
  subjectPostId String?
  subjectId     String
  sectionId     String
  title         String
  description   String?
  dueDate       DateTime
  createdById   String
  createdAt     DateTime             @default(now())
  institution   Institution          @relation(fields: [institutionId], references: [id])
  subject       Subject              @relation(fields: [subjectId], references: [id])
  completions   HomeworkCompletion[]
  subjectPost   SubjectPost?         @relation(fields: [subjectPostId], references: [id])
}

model HomeworkCompletion {
  id         String      @id @default(cuid())
  homeworkId String
  studentId  String
  isDone     Boolean     @default(false)
  isChecked  Boolean     @default(false)
  markedAt   DateTime?
  homework   HomeworkLog @relation(fields: [homeworkId], references: [id])
  student    Student     @relation(fields: [studentId], references: [id])

  @@unique([homeworkId, studentId])
}

model LessonPlan {
  id              String      @id @default(cuid())
  institutionId   String
  subjectId       String
  title           String
  description     String?
  targetWeekStart DateTime    @db.Date
  targetWeekEnd   DateTime    @db.Date
  completedAt     DateTime?
  completionNote  String?
  createdById     String
  createdAt       DateTime    @default(now())
  institution     Institution @relation(fields: [institutionId], references: [id])
  subject         Subject     @relation(fields: [subjectId], references: [id])
}

// ─── Exam Scheduling ───

model ExamSchedule {
  id            String      @id @default(cuid())
  institutionId String
  classYearId   String
  subjectId     String
  examTypeId    String
  date          DateTime
  startTime     String
  duration      Int
  hallRoom      String?
  totalMarks    Int         @default(100)
  instructions  String?
  createdById   String
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  classYear     ClassYear   @relation(fields: [classYearId], references: [id])
  subject       Subject     @relation(fields: [subjectId], references: [id])
  examType      ExamType    @relation(fields: [examTypeId], references: [id])
}

// ─── Substitution ───

model SubstitutionRecord {
  id                  String      @id @default(cuid())
  institutionId       String
  originalTeacherId   String
  substituteTeacherId String
  originalStaffId     String?
  substituteStaffId   String?
  sectionId           String
  date                DateTime    @db.Date
  periodNumber        Int
  reason              String?
  notifiedAt          DateTime?
  createdById         String
  createdAt           DateTime    @default(now())
  institution         Institution @relation(fields: [institutionId], references: [id])
  section             Section     @relation(fields: [sectionId], references: [id])
  originalStaff       Staff?      @relation("OriginalTeacher", fields: [originalStaffId], references: [id])
  substituteStaff     Staff?      @relation("SubstituteTeacher", fields: [substituteStaffId], references: [id])
}

// ─── Standalone Courses ───

model Course {
  id               String             @id @default(cuid())
  institutionId    String
  title            String
  description      String?
  instructorId     String
  targetType       CourseTarget       @default(ALL)
  targetIds        String[]           @default([])
  maxEnrollment    Int?
  enrollmentStart  DateTime?
  enrollmentEnd    DateTime?
  status           CourseStatus       @default(DRAFT)
  clonedFromId     String?
  canPreviewFiles  Boolean            @default(true)
  canDownloadFiles Boolean            @default(false)
  createdAt        DateTime           @default(now())
  institution      Institution        @relation(fields: [institutionId], references: [id])
  posts            CoursePost[]
  enrollments      CourseEnrollment[]
}

enum CourseTarget {
  ALL
  CLASS
  SECTION
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model CoursePost {
  id          String             @id @default(cuid())
  courseId    String
  type        SubjectPostType
  title       String
  description String?
  scheduledAt DateTime?
  isPublished Boolean            @default(true)
  canPreview  Boolean            @default(true)
  canDownload Boolean            @default(false)
  order       Int                @default(0)
  topicTag    String?
  createdById String
  createdAt   DateTime           @default(now())
  course      Course             @relation(fields: [courseId], references: [id])
  attachments CourseAttachment[]
}

model CourseAttachment {
  id           String         @id @default(cuid())
  coursePostId String
  type         AttachmentType
  url          String
  fileName     String?
  fileSize     Int?
  mimeType     String?
  canPreview   Boolean        @default(true)
  canDownload  Boolean        @default(false)
  coursePost   CoursePost     @relation(fields: [coursePostId], references: [id])
}

model CourseEnrollment {
  id               String    @id @default(cuid())
  courseId          String
  studentId         String
  enrolledAt        DateTime  @default(now())
  completedAt       DateTime?
  progressPercent   Int       @default(0)
  completedPostIds  Json      @default("[]")
  course            Course    @relation(fields: [courseId], references: [id])
  student           Student   @relation(fields: [studentId], references: [id])

  @@unique([courseId, studentId])
}

// ─── Staff Module ───

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  LATE
}

model Department {
  id            String      @id @default(cuid())
  institutionId String
  name          String
  description   String?
  hodId         String?
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  staff         Staff[]

  @@unique([institutionId, name])
}

model StaffRole {
  id            String                @id @default(cuid())
  institutionId String
  name          String
  description   String?
  isSystemRole  Boolean               @default(false)
  permissions   Json                  @default("[]")
  createdAt     DateTime              @default(now())
  institution   Institution           @relation(fields: [institutionId], references: [id])
  primaryStaff  Staff[]               @relation("PrimaryRole")
  assignments   StaffRoleAssignment[]

  @@unique([institutionId, name])
}

model Staff {
  id              String      @id @default(cuid())
  institutionId   String
  userId          String?     @unique
  employeeNo      String
  firstName       String
  lastName        String
  designation     String
  phone           String?
  personalEmail   String?
  qualification   String?
  specialization  String?
  joiningDate     DateTime    @db.Date
  status          StaffStatus @default(ACTIVE)
  departmentId    String?
  primaryRoleId   String?
  reportsToId     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  institution      Institution           @relation(fields: [institutionId], references: [id])
  user             User?                 @relation(fields: [userId], references: [id])
  department       Department?           @relation(fields: [departmentId], references: [id])
  primaryRole      StaffRole?            @relation("PrimaryRole", fields: [primaryRoleId], references: [id])
  reportsTo        Staff?                @relation("StaffHierarchy", fields: [reportsToId], references: [id])
  directReports    Staff[]               @relation("StaffHierarchy")
  secondaryRoles   StaffRoleAssignment[]
  classTeaching    ClassTeacherAssignment[]
  leaves           StaffLeave[]
  attendance       StaffAttendance[]
  salary           StaffSalary[]
  documents        StaffDocument[]
  performanceNotes PerformanceNote[]
  idCards          StaffIdCard[]
  subjectTeaching  SubjectTeacher[]
  substitutionsGiven   SubstitutionRecord[] @relation("OriginalTeacher")
  substitutionsCovered SubstitutionRecord[] @relation("SubstituteTeacher")

  @@unique([institutionId, employeeNo])
}

model StaffRoleAssignment {
  id           String    @id @default(cuid())
  staffId      String
  staffRoleId  String
  assignedAt   DateTime  @default(now())
  assignedById String
  staff        Staff     @relation(fields: [staffId], references: [id])
  staffRole    StaffRole @relation(fields: [staffRoleId], references: [id])

  @@unique([staffId, staffRoleId])
}

model ClassTeacherAssignment {
  id             String       @id @default(cuid())
  institutionId  String
  staffId        String
  sectionId      String
  academicYearId String
  assignedAt     DateTime     @default(now())
  institution    Institution  @relation(fields: [institutionId], references: [id])
  staff          Staff        @relation(fields: [staffId], references: [id])
  section        Section      @relation(fields: [sectionId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([sectionId, academicYearId])
}

model StaffLeaveType {
  id              String      @id @default(cuid())
  institutionId   String
  name            String
  shortName       String
  maxDaysPerYear  Int         @default(12)
  carryForward    Boolean     @default(false)
  isPaid          Boolean     @default(true)
  institution     Institution @relation(fields: [institutionId], references: [id])
  leaves          StaffLeave[]

  @@unique([institutionId, name])
}

model StaffLeave {
  id                 String         @id @default(cuid())
  institutionId      String
  staffId            String
  leaveTypeId        String
  fromDate           DateTime       @db.Date
  toDate             DateTime       @db.Date
  totalDays          Int
  reason             String
  status             LeaveStatus    @default(PENDING)
  approvedById       String?
  approvalComment    String?
  appliedAt          DateTime       @default(now())
  reviewedAt         DateTime?
  substituteArranged Boolean        @default(false)
  substituteStaffId  String?
  institution        Institution    @relation(fields: [institutionId], references: [id])
  staff              Staff          @relation(fields: [staffId], references: [id])
  leaveType          StaffLeaveType @relation(fields: [leaveTypeId], references: [id])
}

model StaffAttendance {
  id            String                @id @default(cuid())
  institutionId String
  staffId       String
  date          DateTime              @db.Date
  checkInTime   String?
  checkOutTime  String?
  status        StaffAttendanceStatus @default(PRESENT)
  notes         String?
  markedById    String
  createdAt     DateTime              @default(now())
  institution   Institution           @relation(fields: [institutionId], references: [id])
  staff         Staff                 @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
}

model StaffSalaryConfig {
  id              String      @id @default(cuid())
  institutionId   String      @unique
  allowanceTypes  Json        @default("[]")
  deductionTypes  Json        @default("[]")
  institution     Institution @relation(fields: [institutionId], references: [id])
}

model StaffSalary {
  id              String      @id @default(cuid())
  institutionId   String
  staffId         String
  month           Int
  year            Int
  basicSalary     Decimal     @db.Decimal(12, 2)
  allowances      Json        @default("[]")
  deductions      Json        @default("[]")
  lopDays         Int         @default(0)
  lopDeduction    Decimal     @db.Decimal(12, 2) @default(0)
  grossSalary     Decimal     @db.Decimal(12, 2)
  netSalary       Decimal     @db.Decimal(12, 2)
  paidAt          DateTime?
  payslipUrl      String?
  notes           String?
  processedById   String
  createdAt       DateTime    @default(now())
  institution     Institution @relation(fields: [institutionId], references: [id])
  staff           Staff       @relation(fields: [staffId], references: [id])

  @@unique([staffId, month, year])
}

model StaffDocument {
  id                   String      @id @default(cuid())
  institutionId        String
  staffId              String
  documentType         String
  fileUrl              String
  fileName             String
  fileSize             Int?
  mimeType             String?
  isVerified           Boolean     @default(false)
  verifiedById         String?
  verifiedAt           DateTime?
  uploadedById         String
  notes                String?
  createdAt            DateTime    @default(now())
  institution          Institution @relation(fields: [institutionId], references: [id])
  staff                Staff       @relation(fields: [staffId], references: [id])
}

model PerformanceNote {
  id            String      @id @default(cuid())
  institutionId String
  staffId       String
  note          String
  rating        Int?
  isPrivate     Boolean     @default(true)
  createdById   String
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  staff         Staff       @relation(fields: [staffId], references: [id])
}

model StaffIdCard {
  id         String   @id @default(cuid())
  staffId    String
  issuedById String
  issuedAt   DateTime @default(now())
  validTill  DateTime
  fileUrl    String?
  isActive   Boolean  @default(true)
  staff      Staff    @relation(fields: [staffId], references: [id])
}

model StaffSettings {
  id                    String      @id @default(cuid())
  institutionId         String      @unique
  employeeNoPrefix      String      @default("EMP")
  employeeNoCurrentSeq  Int         @default(1001)
  documentTypes         Json        @default("[]")
  institution           Institution @relation(fields: [institutionId], references: [id])
}

// ─── Notifications ───────────────────────────────────────────

model Notification {
  id              String               @id @default(cuid())
  institutionId   String
  userId          String
  type            NotificationType
  title           String
  body            String
  channel         NotificationChannel  @default(PUSH)
  status          NotificationStatus   @default(PENDING)
  priority        NotificationPriority @default(NORMAL)
  data            Json                 @default("{}")
  scheduledAt     DateTime?
  sentAt          DateTime?
  readAt          DateTime?
  createdAt       DateTime             @default(now())
  institution     Institution          @relation(fields: [institutionId], references: [id])
  user            User                 @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([institutionId, createdAt])
}

model NotificationTemplate {
  id              String              @id @default(cuid())
  institutionId   String
  type            NotificationType
  name            String
  titleTemplate   String
  bodyTemplate    String
  channel         NotificationChannel
  isActive        Boolean             @default(true)
  institution     Institution         @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, type, channel])
}

model NotificationPreference {
  id              String      @id @default(cuid())
  userId          String      @unique
  institutionId   String
  pushEnabled     Boolean     @default(true)
  emailEnabled    Boolean     @default(true)
  smsEnabled      Boolean     @default(false)
  whatsappEnabled Boolean     @default(true)
  mutedTypes      String[]    @default([])
  quietHoursStart String?
  quietHoursEnd   String?
  user            User        @relation(fields: [userId], references: [id])
  institution     Institution @relation(fields: [institutionId], references: [id])
}
