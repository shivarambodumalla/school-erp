  moduleItem   SubjectModuleItem @relation(fields: [moduleItemId], references: [id], onDelete: Cascade)
  student      Student           @relation(fields: [studentId], references: [id])
  subject      Subject           @relation(fields: [subjectId], references: [id])

  @@unique([studentId, moduleItemId])
}

model SubjectAssignment {
  id                  String                        @id @default(cuid())
  moduleItemId        String                        @unique
  subjectId           String
  dueDate             DateTime
  totalMarks          Int                           @default(100)
  allowLateSubmission Boolean                       @default(false)
  latePenaltyPercent  Int                           @default(0)
  maxAttempts         Int                           @default(1)
  instructions        String?
  isGroupAssignment   Boolean                       @default(false)
  groupSetId          String?
  rubricId            String?
  hasPeerAssessment   Boolean                       @default(false)
  hasSimilarityCheck  Boolean                       @default(false)
  similarityThreshold Int                           @default(70)
  peerAssessment      PeerAssessment?               @relation("SubjectAssignmentPeerAssessment")
  moduleItem          SubjectModuleItem             @relation(fields: [moduleItemId], references: [id], onDelete: Cascade)
  subject             Subject                       @relation(fields: [subjectId], references: [id])
  submissions         SubjectAssignmentSubmission[]
}

model SubjectAssignmentSubmission {
  id               String                 @id @default(cuid())
  assignmentId     String
  studentId        String
  groupId          String?
  attempt          Int                    @default(1)
  fileUrls         String[]               @default([])
  textContent      String?
  submittedAt      DateTime               @default(now())
  isLate           Boolean                @default(false)
  status           SubmissionStatus       @default(SUBMITTED)
  marksObtained    Decimal?               @db.Decimal(5, 2)
  feedback         String?
  returnReason     String?
  gradedById       String?
  gradedAt         DateTime?
  similarityScore  Int?
  similarityResult SimilarityCheckResult?
  assignment       SubjectAssignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student          Student                @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId, attempt])
}

model Rubric {
  id            String      @id @default(cuid())
  institutionId String
  subjectId     String?
  name          String
  description   String?
  criteria      Json        @default("[]")
  isShared      Boolean     @default(false)
  createdById   String
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  subject       Subject?    @relation(fields: [subjectId], references: [id])
}

model QuestionBank {
  id            String             @id @default(cuid())
  institutionId String
  subjectId     String?
  name          String
  description   String?
  isShared      Boolean            @default(false)
  createdById   String
  createdAt     DateTime           @default(now())
  institution   Institution        @relation(fields: [institutionId], references: [id])
  subject       Subject?           @relation(fields: [subjectId], references: [id])
