  @@unique([peerAssessmentId, reviewerId, revieweeId])
}

model SubjectGradebookConfig {
  id                      String         @id @default(cuid())
  subjectId               String         @unique
  weightageRules          Json           @default("[]")
  passingPercent          Int            @default(40)
  showWeightageToStudents Boolean        @default(true)
  roundingMethod          RoundingMethod @default(NEAREST)
  subject                 Subject        @relation(fields: [subjectId], references: [id])
}

model SubjectResource {
  id            String      @id @default(cuid())
  subjectId     String
  institutionId String
