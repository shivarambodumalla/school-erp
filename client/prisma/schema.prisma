generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id                String                   @id @default(cuid())
  name              String
  subdomain         String                   @unique
  primaryColor      String                   @default("#1d4ed8")
  logoUrl           String?
  planTier          PlanTier                 @default(STARTER)
  board             Board                    @default(CBSE)
  isActive          Boolean                  @default(true)
  suspendedAt       DateTime?
  suspendedReason   String?
  billingEmail      String?
  customPricing     Decimal?                 @db.Decimal(10, 2)

  // White labeling
  secondaryColor    String?
  themePalette      Json?
  darkPalette       Json?
  faviconUrl        String?
  emailHeader       String?
  themeAppliedAt    DateTime?

  // Additional details
  institutionType   InstitutionType          @default(SCHOOL)
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  pinCode           String?
  phone             String?
  website           String?
  establishedYear   Int?
  studentCapacity   Int?

  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  users             User[]
  students          Student[]
  roles             Role[]
  onboarding        OnboardingStep?
  documents         Document[]
  calendarEvents    SchoolCalendarEvent[]
  tickets           SupportTicket[]
  communicationLogs ParentCommunicationLog[]
}

model User {
  id             String      @id @default(cuid())
  institutionId  String
  institution    Institution @relation(fields: [institutionId], references: [id])
  email          String
  hashedPassword String
  portalType     PortalType
  isActive       Boolean     @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime    @default(now())
  @@unique([institutionId, email])
}

model Student {
  id            String        @id @default(cuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id])
  userId        String?       @unique
  admissionNo   String
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  gender        Gender
  classId       String
  sectionId     String
  photoUrl      String?
  guardianName  String
  guardianPhone String
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  @@unique([institutionId, admissionNo])
}

model AcademicYear {
  id            String   @id @default(cuid())
  institutionId String
  name          String
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean  @default(false)
}

model Class {
  id             String    @id @default(cuid())
  institutionId  String
  academicYearId String
  name           String
  gradeLevel     Int
  sections       Section[]
}

model Section {
  id             String  @id @default(cuid())
  classId        String
  class          Class   @relation(fields: [classId], references: [id])
  name           String
  classTeacherId String?
}

model Attendance {
  id            String           @id @default(cuid())
  institutionId String
  studentId     String
  date          DateTime         @db.Date
  status        AttendanceStatus
  markedById    String
  markedAt      DateTime         @default(now())
  @@unique([studentId, date])
}

model FeePayment {
  id              String        @id @default(cuid())
  institutionId   String
  studentId       String
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  razorpayOrderId String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
}

model AuditLog {
  id            String   @id @default(cuid())
  institutionId String
  userId        String
  action        String
  tableName     String
  recordId      String
  before        Json?
  after         Json?
  createdAt     DateTime @default(now())
}

model Role {
  id               String          @id @default(cuid())
  institutionId    String
  name             String
  isSystemRole     Boolean         @default(false)
  permissions      Json            @default("[]")
  masqueradeMode   MasqueradeMode  @default(READ_ONLY)
  createdAt        DateTime        @default(now())
  institution      Institution     @relation(fields: [institutionId], references: [id])
}

enum MasqueradeMode {
  READ_ONLY
  FULL_ACCESS
  DISABLED
}

enum PlanTier {
  STARTER
  GROWTH
  PRO
}

enum Board {
  CBSE
  ICSE
  STATE
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  TRAINING_CENTER
}

enum PortalType {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
  INSTRUCTOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  EXCUSED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  CASH
  CHEQUE
  EMI
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DocumentType {
  TRANSFER_CERTIFICATE
  ADMISSION_FORM
  MARKSHEET
  ID_PROOF
  MEDICAL_RECORD
  STAFF_CONTRACT
  OTHER
}

enum CalendarEventType {
  HOLIDAY
  EXAM
  EVENT
  MEETING
  DEADLINE
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  SENT
  DELIVERED
  FAILED
  PENDING
}

model OnboardingStep {
  id            String      @id @default(cuid())
  institutionId String      @unique
  institution   Institution @relation(fields: [institutionId], references: [id])
  classesAdded  Boolean     @default(false)
  staffAdded    Boolean     @default(false)
  studentsAdded Boolean     @default(false)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
}

model Document {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  studentId     String?
  staffId       String?
  uploadedById  String
  name          String
  type          DocumentType
  fileUrl       String
  fileSize      Int
  mimeType      String
  isVerified    Boolean      @default(false)
  createdAt     DateTime     @default(now())
}

model SchoolCalendarEvent {
  id            String            @id @default(cuid())
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id])
  title         String
  description   String?
  type          CalendarEventType
  startDate     DateTime
  endDate       DateTime
  isHoliday     Boolean           @default(false)
  createdById   String
  createdAt     DateTime          @default(now())
}

model SupportTicket {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id])
  raisedById    String
  title         String
  description   String
  priority      TicketPriority  @default(MEDIUM)
  status        TicketStatus    @default(OPEN)
  resolvedById  String?
  resolvedAt    DateTime?
  messages      TicketMessage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  authorId   String
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
}

model ParentCommunicationLog {
  id            String              @id @default(cuid())
  institutionId String
  institution   Institution         @relation(fields: [institutionId], references: [id])
  studentId     String
  sentById      String
  channel       NotificationChannel
  subject       String?
  body          String
  status        NotificationStatus  @default(SENT)
  sentAt        DateTime            @default(now())
}

model PlatformRole {
  id             String         @id @default(cuid())
  name           String         @unique
  description    String?
  permissions    Json           @default("[]")
  masqueradeMode MasqueradeMode @default(DISABLED)
  isSystemRole   Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  users          PlatformUser[]
}

model PlatformUser {
  id             String       @id @default(cuid())
  email          String       @unique
  hashedPassword String
  platformRoleId String
  platformRole   PlatformRole @relation(fields: [platformRoleId], references: [id])
  isActive       Boolean      @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
}
