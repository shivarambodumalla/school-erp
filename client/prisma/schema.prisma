  @@unique([meritListId, admissionId])
  @@index([meritListId, rank])
}

model KudosConfig {
  id            String      @id @default(cuid())
  institutionId String      @unique
  badgePoints   Json        @default("{\"STAR\": 10, \"CROWN\": 50, \"HEART\": 10, \"TROPHY\": 25, \"LIGHTNING\": 15, \"THUMBS_UP\": 5}")
  institution   Institution @relation(fields: [institutionId], references: [id])
}

model Kudos {
  id            String      @id @default(cuid())
  institutionId String
  studentId     String
  teacherId     String
  badgeType     KudosBadge
  title         String
  description   String?
  points        Int
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  student       Student     @relation(fields: [studentId], references: [id])
  teacher       Staff       @relation(fields: [teacherId], references: [id])

  @@index([institutionId, studentId])
  @@index([institutionId, teacherId])
}

model SchoolCircular {
  id             String           @id @default(cuid())
  institutionId  String
  title          String
  content        String
  targetClassIds String[]         @default([])
  isPinned       Boolean          @default(false)
  publishedAt    DateTime?
  expiresAt      DateTime?
  createdById    String
  createdAt      DateTime         @default(now())
  fileUrls       String[]         @default([])
  targetAudience CircularAudience @default(ALL)
  updatedAt      DateTime         @updatedAt
  reads          CircularRead[]
  createdBy      Staff            @relation(fields: [createdById], references: [id])
  institution    Institution      @relation(fields: [institutionId], references: [id])

  @@index([institutionId, publishedAt])
  @@index([institutionId, targetAudience])
}

model CircularRead {
  id         String         @id @default(cuid())
  circularId String
  userId     String
  readAt     DateTime       @default(now())
  circular   SchoolCircular @relation(fields: [circularId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id])

  @@unique([circularId, userId])
}

model ReportCardGeneration {
  id                String           @id @default(cuid())
  institutionId     String
  classYearId       String
  academicYearId    String
  examTypeIds       String[]         @default([])
  includeAttendance Boolean          @default(true)
  includeRemarks    Boolean          @default(true)
  gradingScale      Json?
  status            ReportCardStatus @default(DRAFT)
  generatedAt       DateTime?
  createdById       String
  createdAt         DateTime         @default(now())
  publishedAt       DateTime?
  updatedAt         DateTime         @updatedAt
  cards             ReportCard[]
  academicYear      AcademicYear     @relation(fields: [academicYearId], references: [id])
  classYear         ClassYear        @relation(fields: [classYearId], references: [id])
  institution       Institution      @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, classYearId, academicYearId])
}

model ReportCard {
  id           String               @id @default(cuid())
  generationId String
  studentId    String
  pdfUrl       String?
  remarks      String?
  createdAt    DateTime             @default(now())
  generation   ReportCardGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  student      Student              @relation(fields: [studentId], references: [id])

  @@unique([generationId, studentId])
}

model AcademicYearPreference {
  id             String       @id @default(cuid())
  userId         String       @unique
  institutionId  String
  academicYearId String
  updatedAt      DateTime     @updatedAt
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  institution    Institution  @relation(fields: [institutionId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

