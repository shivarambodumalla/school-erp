}

model QuestionBankItem {
  id              String          @id @default(cuid())
  questionBankId  String
  institutionId   String
  type            QuestionType
  text            String
  options         Json            @default("[]")
  correctAnswer   String?
  explanation     String?
  marks           Int             @default(1)
  difficultyLevel DifficultyLevel @default(MEDIUM)
  tags            String[]        @default([])
  subjectName     String?
  topicTag        String?
  timesUsed       Int             @default(0)
  createdById     String
  createdAt       DateTime        @default(now())
  institution     Institution     @relation(fields: [institutionId], references: [id])
  questionBank    QuestionBank    @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
}

model SubjectDiscussion {
  id             String                   @id @default(cuid())
  moduleItemId   String                   @unique
  subjectId      String
  prompt         String
  allowAnonymous Boolean                  @default(false)
  closedAt       DateTime?
  moduleItem     SubjectModuleItem        @relation(fields: [moduleItemId], references: [id], onDelete: Cascade)
  subject        Subject                  @relation(fields: [subjectId], references: [id])
  replies        SubjectDiscussionReply[]
}

model SubjectDiscussionReply {
  id            String                   @id @default(cuid())
  discussionId  String
  userId        String
  subjectId     String
  content       String
  parentReplyId String?
  isBestAnswer  Boolean                  @default(false)
  upvotes       Int                      @default(0)
  isAnonymous   Boolean                  @default(false)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  discussion    SubjectDiscussion        @relation(fields: [discussionId], references: [id], onDelete: Cascade)
