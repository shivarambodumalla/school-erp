}

model SubjectLiveClass {
  id              String            @id @default(cuid())
  moduleItemId    String            @unique
  subjectId       String
  platform        LiveClassPlatform
  meetUrl         String
  scheduledAt     DateTime
  durationMinutes Int               @default(60)
  agenda          String?
  recordingUrl    String?
  createdAt       DateTime          @default(now())
  moduleItem      SubjectModuleItem @relation(fields: [moduleItemId], references: [id], onDelete: Cascade)
  subject         Subject           @relation(fields: [subjectId], references: [id])
}

model GroupSet {
  id             String              @id @default(cuid())
  subjectId      String
  institutionId  String
  name           String
  assignmentType GroupAssignmentType
  minSize        Int                 @default(2)
  maxSize        Int                 @default(5)
