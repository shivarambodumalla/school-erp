generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Institution {
  id                      String                   @id @default(cuid())
  name                    String
  subdomain               String                   @unique
  primaryColor            String                   @default("#3730A3")
  logoUrl                 String?
  planTier                PlanTier                 @default(STARTER)
  board                   Board                    @default(CBSE)
  isActive                Boolean                  @default(true)
  suspendedAt             DateTime?
  suspendedReason         String?
  billingEmail            String?
  customPricing           Decimal?                 @db.Decimal(10, 2)
  secondaryColor          String?
  themePalette            Json?
  darkPalette             Json?
  squareLogoUrl           String?
  faviconUrl              String?
  emailHeader             String?
  themeAppliedAt          DateTime?
  institutionType         InstitutionType          @default(SCHOOL)
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  pinCode                 String?
  phone                   String?
  website                 String?
  establishedYear         Int?
  studentCapacity         Int?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  academicYearPreferences AcademicYearPreference[]
  achievements            Achievement[]
  admissions              Admission[]
  admissionSettings       AdmissionSettings?
  attendance              Attendance[]
  attendanceSettings      AttendanceSettings?
  behaviourIncidents      BehaviourIncident[]
  classTeacherAssignments ClassTeacherAssignment[]
  classTemplates          ClassTemplate[]
  classYears              ClassYear[]
  counsellorNotes         CounsellorNote[]
  courses                 Course[]
  departments             Department[]
  deptAnnouncements       DeptAnnouncement[]
  documents               Document[]
  documentTypeConfigs     DocumentTypeConfig[]
  enquiryFormSettings     EnquiryFormSettings?
  examSchedules           ExamSchedule[]
  examTypes               ExamType[]
  feeCategories           FeeCategory[]
  feeConcessions          FeeConcession[]
  feeFines                FeeFine[]
  feePayments             FeePayment[]
  feeReminders            FeeReminder[]
  feeSettings             FeeSettings?
  gradeEntries            GradeEntry[]
  groupSets               GroupSet[]
  homeworkLogs            HomeworkLog[]
  inquiries               Inquiry[]
  kudos                   Kudos[]
  kudosConfig             KudosConfig?
  leads                   Lead[]
  leadFollowUps           LeadFollowUp[]
  leadLabels              LeadLabel[]
  lessonPlans             LessonPlan[]
  meritListConfigs        MeritListConfig[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationTemplates   NotificationTemplate[]
  onboarding              OnboardingStep?
  communicationLogs       ParentCommunicationLog[]
  performanceNotes        PerformanceNote[]
  promotionRecords        PromotionRecord[]
  questionBanks           QuestionBank[]
  questionBankItems       QuestionBankItem[]
  reportCardGenerations   ReportCardGeneration[]
  roles                   Role[]
  rubrics                 Rubric[]
  calendarEvents          SchoolCalendarEvent[]
  circulars               SchoolCircular[]
  sections                Section[]
  staff                   Staff[]
  staffAttendance         StaffAttendance[]
  staffDocuments          StaffDocument[]
  staffLeaves             StaffLeave[]
  staffLeaveTypes         StaffLeaveType[]
  staffRoles              StaffRole[]
  staffSalaries           StaffSalary[]
  staffSalaryConfig       StaffSalaryConfig?
  staffSettings           StaffSettings?
  students                Student[]
  studentSections         StudentSection[]
  subjects                Subject[]
  subjectAnnouncements    SubjectAnnouncement[]
  subjectExportJobs       SubjectExportJob[]
  subjectPosts            SubjectPost[]
  subjectResources        SubjectResource[]
  substitutions           SubstitutionRecord[]
  tickets                 SupportTicket[]
  timetableSlots          TimetableSlot[]
  users                   User[]
}

model User {
  id                     String                  @id @default(cuid())
  institutionId          String
  email                  String
  hashedPassword         String
  portalType             PortalType
  isActive               Boolean                 @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime                @default(now())
  academicYearPreference AcademicYearPreference?
  circularReads          CircularRead[]
  deptAnnouncements      DeptAnnouncement[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  staff                  Staff?
  subjectTeacher         SubjectTeacher[]
  institution            Institution             @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, email])
}

model Student {
  id                           String                        @id @default(cuid())
  serialNo                     Int                           @unique @default(autoincrement())
  institutionId                String
  userId                       String?                       @unique
  admissionId                  String?                       @unique
  admissionNo                  String
  sisId                        String                        @unique
  rollNo                       String?
  firstName                    String
  middleName                   String?
  lastName                     String
  dateOfBirth                  DateTime
  gender                       Gender
  bloodGroup                   String?
  nationality                  String?
  religion                     String?
  motherTongue                 String?
  photoUrl                     String?
  idProofType                  String?
  idProofNumber                String?
  guardianName                 String
  guardianPhone                String
  status                       StudentStatus                 @default(ACTIVE)
  allergies                    String[]                      @default([])
  medicalConditions            Json                          @default("[]")
  emergencyDoctorName          String?
  emergencyDoctorPhone         String?
  transportMode                TransportMode                 @default(DAY_SCHOLAR)
  busRouteId                   String?
  pickupStop                   String?
  dropStop                     String?
  boardingType                 BoardingType                  @default(DAY_SCHOLAR)
  hostelRoom                   String?
  createdAt                    DateTime                      @default(now())
  achievements                 Achievement[]
  submissions                  AssignmentSubmission[]
  attendance                   Attendance[]
  incidents                    BehaviourIncident[]
  counsellorNotes              CounsellorNote[]
  courseEnrollments            CourseEnrollment[]
  feeConcessions               FeeConcession[]
  feePayments                  FeePayment[]
  gradeEntries                 GradeEntry[]
  guardians                    Guardian[]
  homework                     HomeworkCompletion[]
  kudos                        Kudos[]
  pollVotes                    PollVote[]
  promotions                   PromotionRecord[]
  quizAttempts                 QuizAttempt[]
  reportCards                  ReportCard[]
  admission                    Admission?                    @relation(fields: [admissionId], references: [id])
  institution                  Institution                   @relation(fields: [institutionId], references: [id])
  documents                    StudentDocument[]
  exit                         StudentExit?
  idCards                      StudentIdCard[]
  moduleItemProgress           StudentModuleItemProgress[]
  studentNotes                 StudentNote[]
  sections                     StudentSection[]
  siblingOf                    StudentSibling[]              @relation("SiblingOf")
  siblings                     StudentSibling[]              @relation("StudentSiblings")
  subjectAssignmentSubmissions SubjectAssignmentSubmission[]
  subjectCertificates          SubjectCertificate[]
  subjectGroupMemberships      SubjectGroupMember[]

  @@unique([institutionId, admissionNo])
}

model AcademicYear {
  id                      String                   @id @default(cuid())
  institutionId           String
  name                    String
  startDate               DateTime
  endDate                 DateTime
  isCurrent               Boolean                  @default(false)
  academicYearPreferences AcademicYearPreference[]
  classTeacherAssignments ClassTeacherAssignment[]
  classYears              ClassYear[]
  meritListConfigs        MeritListConfig[]
  reportCardGenerations   ReportCardGeneration[]
}

model FeeCategory {
  id            String        @id @default(cuid())
  institutionId String
  name          String
  description   String?
  amount        Decimal       @db.Decimal(12, 2)
  frequency     FeeFrequency  @default(MONTHLY)
  isOptional    Boolean       @default(false)
  applicableTo  FeeApplicable @default(ALL)
  classYearIds  String[]      @default([])
  sectionIds    String[]      @default([])
  isActive      Boolean       @default(true)
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  institution   Institution   @relation(fields: [institutionId], references: [id])
  payments      FeePayment[]
  reminders     FeeReminder[]

  @@unique([institutionId, name])
}

model FeePayment {
  id             String           @id @default(cuid())
  institutionId  String
  studentId      String
  feeCategoryId  String
  amount         Decimal          @db.Decimal(12, 2)
  fineAmount     Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal          @db.Decimal(12, 2)
  status         FeePaymentStatus @default(PENDING)
  method         PaymentMethod?
  receiptNo      String?          @unique
  transactionRef String?
  dueDate        DateTime         @db.Date
  paidAt         DateTime?
  month          Int?
  year           Int?
  notes          String?
  collectedById  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  feeCategory    FeeCategory      @relation(fields: [feeCategoryId], references: [id])
  institution    Institution      @relation(fields: [institutionId], references: [id])
  student        Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, feeCategoryId, month, year])
}

model FeeFine {
  id            String      @id @default(cuid())
  institutionId String
  feeCategoryId String?
  name          String
  type          FineType    @default(FIXED)
  amount        Decimal     @db.Decimal(10, 2)
  graceDays     Int         @default(0)
  maxAmount     Decimal?    @db.Decimal(10, 2)
  isActive      Boolean     @default(true)
  institution   Institution @relation(fields: [institutionId], references: [id])
}

model FeeReminder {
  id              String       @id @default(cuid())
  institutionId   String
  feeCategoryId   String?
  daysBeforeDue   Int
  channel         String
  messageTemplate String
  isActive        Boolean      @default(true)
  feeCategory     FeeCategory? @relation(fields: [feeCategoryId], references: [id])
  institution     Institution  @relation(fields: [institutionId], references: [id])
}

model FeeConcession {
  id            String         @id @default(cuid())
  institutionId String
  studentId     String
  feeCategoryId String?
  name          String
  type          ConcessionType
  amount        Decimal        @db.Decimal(10, 2)
  validFrom     DateTime       @db.Date
  validTill     DateTime?      @db.Date
  approvedById  String
  notes         String?
  createdAt     DateTime       @default(now())
  institution   Institution    @relation(fields: [institutionId], references: [id])
  student       Student        @relation(fields: [studentId], references: [id])
}

model FeeSettings {
  id                    String      @id @default(cuid())
  institutionId         String      @unique
  receiptPrefix         String      @default("RCP")
  receiptCurrentSeq     Int         @default(1001)
  lateFineEnabled       Boolean     @default(false)
  reminderEnabled       Boolean     @default(false)
  partialPaymentAllowed Boolean     @default(true)
  institution           Institution @relation(fields: [institutionId], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  institutionId String
  userId        String
  action        String
  tableName     String
  recordId      String
  before        Json?
  after         Json?
  createdAt     DateTime @default(now())
}

model Role {
  id             String         @id @default(cuid())
  institutionId  String
  name           String
  isSystemRole   Boolean        @default(false)
  permissions    Json           @default("[]")
  masqueradeMode MasqueradeMode @default(READ_ONLY)
  createdAt      DateTime       @default(now())
  institution    Institution    @relation(fields: [institutionId], references: [id])
}

model OnboardingStep {
  id            String      @id @default(cuid())
  institutionId String      @unique
  classesAdded  Boolean     @default(false)
  staffAdded    Boolean     @default(false)
  studentsAdded Boolean     @default(false)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
}

model Document {
  id            String       @id @default(cuid())
  institutionId String
  studentId     String?
  staffId       String?
  uploadedById  String
  name          String
  type          DocumentType
  fileUrl       String
  fileSize      Int
  mimeType      String
  isVerified    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  institution   Institution  @relation(fields: [institutionId], references: [id])
}

model SchoolCalendarEvent {
  id            String            @id @default(cuid())
  institutionId String
  title         String
  description   String?
  type          CalendarEventType
  startDate     DateTime
  endDate       DateTime
  isHoliday     Boolean           @default(false)
  createdById   String
  createdAt     DateTime          @default(now())
  institution   Institution       @relation(fields: [institutionId], references: [id])
}

model SupportTicket {
  id            String          @id @default(cuid())
  institutionId String
  raisedById    String
  title         String
  description   String
  priority      TicketPriority  @default(MEDIUM)
  status        TicketStatus    @default(OPEN)
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  institution   Institution     @relation(fields: [institutionId], references: [id])
  messages      TicketMessage[]
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  authorId   String
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
}

model ParentCommunicationLog {
  id            String              @id @default(cuid())
  institutionId String
  studentId     String
  sentById      String
  channel       NotificationChannel
  subject       String?
  body          String
  status        NotificationStatus  @default(SENT)
  sentAt        DateTime            @default(now())
  institution   Institution         @relation(fields: [institutionId], references: [id])
}

model PlatformRole {
  id             String         @id @default(cuid())
  name           String         @unique
  description    String?
  permissions    Json           @default("[]")
  masqueradeMode MasqueradeMode @default(DISABLED)
  isSystemRole   Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  users          PlatformUser[]
}

model PlatformUser {
  id             String       @id @default(cuid())
  email          String       @unique
  hashedPassword String
  platformRoleId String
  isActive       Boolean      @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  platformRole   PlatformRole @relation(fields: [platformRoleId], references: [id])
}

model AdmissionSettings {
  id                    String      @id @default(cuid())
  institutionId         String      @unique
  admissionNoPrefix     String      @default("ADM")
  admissionNoCurrentSeq Int         @default(1001)
  rollNoPrefix          String      @default("")
  rollNoCurrentSeq      Int         @default(1)
  appNoPrefix           String      @default("APP")
  appNoCurrentSeq       Int         @default(1)
  acceptedIdProofTypes  String[]    @default(["AADHAAR"])
  customFormFields      Json        @default("[]")
  exitDocumentTypes     Json        @default("[]")
  onDemandDocumentTypes Json        @default("[]")
  idCardValidTill       DateTime?
  institution           Institution @relation(fields: [institutionId], references: [id])
}

model DocumentTypeConfig {
  id               String            @id @default(cuid())
  institutionId    String
  name             String
  isRequired       Boolean           @default(false)
  acceptedFormats  String[]          @default(["PDF", "JPEG", "PNG"])
  showInAdmission  Boolean           @default(true)
  showInProfile    Boolean           @default(true)
  order            Int               @default(0)
  institution      Institution       @relation(fields: [institutionId], references: [id])
  studentDocuments StudentDocument[]

  @@unique([institutionId, name])
}

model Inquiry {
  id                     String        @id @default(cuid())
  institutionId          String
  name                   String
  phone                  String
  email                  String?
  source                 InquirySource @default(WALK_IN)
  notes                  String?
  convertedToAdmissionId String?
  createdById            String
  createdAt              DateTime      @default(now())
  institution            Institution   @relation(fields: [institutionId], references: [id])
}

model Admission {
  id                 String            @id @default(cuid())
  serialNo           Int               @unique @default(autoincrement())
  institutionId      String
  applicationNo      String            @unique
  admissionNo        String?           @unique
  status             AdmissionStatus   @default(APPLIED)
  firstName          String
  middleName         String?
  lastName           String
  dateOfBirth        DateTime
  gender             Gender
  bloodGroup         String?
  nationality        String?
  religion           String?
  motherTongue       String?
  photoUrl           String?
  idProofType        String?
  idProofNumber      String?
  idProofDocUrl      String?
  admissionType      AdmissionType     @default(NEW)
  previousSchoolName String?
  previousClass      String?
  previousTCNumber   String?
  classId            String?
  sectionId          String?
  academicYearId     String
  customFieldValues  Json              @default("{}")
  appliedAt          DateTime          @default(now())
  admittedAt         DateTime?
  enrolledAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  createdById        String
  institution        Institution       @relation(fields: [institutionId], references: [id])
  guardians          Guardian[]
  meritListEntries   MeritListEntry[]
  student            Student?
  documents          StudentDocument[]
}

model Guardian {
  id                 String       @id @default(cuid())
  admissionId        String?
  studentId          String?
  type               GuardianType
  relationship       String?
  name               String
  phone              String
  alternatePhone     String?
  email              String?
  occupation         String?
  annualIncome       Decimal?     @db.Decimal(12, 2)
  idProofType        String?
  idProofNumber      String?
  isEmergencyContact Boolean      @default(false)
  isPrimaryContact   Boolean      @default(false)
  canLogin           Boolean      @default(false)
  userId             String?      @unique
  admission          Admission?   @relation(fields: [admissionId], references: [id])
  student            Student?     @relation(fields: [studentId], references: [id])
}

model StudentDocument {
  id                   String              @id @default(cuid())
  institutionId        String
  studentId            String?
  admissionId          String?
  documentTypeConfigId String?
  documentTypeName     String
  fileUrl              String
  fileName             String
  fileSize             Int?
  mimeType             String?
  isVerified           Boolean             @default(false)
  verifiedById         String?
  verifiedAt           DateTime?
  uploadedById         String
  notes                String?
  createdAt            DateTime            @default(now())
  admission            Admission?          @relation(fields: [admissionId], references: [id])
  documentTypeConfig   DocumentTypeConfig? @relation(fields: [documentTypeConfigId], references: [id])
  student              Student?            @relation(fields: [studentId], references: [id])
}

model StudentIdCard {
  id         String   @id @default(cuid())
  studentId  String
  issuedById String
  issuedAt   DateTime @default(now())
  validTill  DateTime
  fileUrl    String?
  isActive   Boolean  @default(true)
  student    Student  @relation(fields: [studentId], references: [id])
}

model StudentSibling {
  id        String  @id @default(cuid())
  studentId String
  siblingId String
  sibling   Student @relation("SiblingOf", fields: [siblingId], references: [id])
  student   Student @relation("StudentSiblings", fields: [studentId], references: [id])

  @@unique([studentId, siblingId])
}

model StudentExit {
  id                String   @id @default(cuid())
  studentId         String   @unique
  exitType          ExitType
  exitDate          DateTime
  destinationSchool String?
  reason            String?
  processedById     String
  createdAt         DateTime @default(now())
  student           Student  @relation(fields: [studentId], references: [id])
}

model BehaviourIncident {
  id             String           @id @default(cuid())
  institutionId  String
  studentId      String
  type           IncidentType
  date           DateTime         @db.Date
  description    String
  actionTaken    String?
  severity       IncidentSeverity
  reportedById   String
  parentNotified Boolean          @default(false)
  createdAt      DateTime         @default(now())
  institution    Institution      @relation(fields: [institutionId], references: [id])
  student        Student          @relation(fields: [studentId], references: [id])
}

model Achievement {
  id            String              @id @default(cuid())
  institutionId String
  studentId     String
  category      AchievementCategory
  title         String
  description   String?
  date          DateTime            @db.Date
  awardedById   String
  photoUrl      String?
  createdAt     DateTime            @default(now())
  institution   Institution         @relation(fields: [institutionId], references: [id])
  student       Student             @relation(fields: [studentId], references: [id])
}

model CounsellorNote {
  id            String      @id @default(cuid())
  institutionId String
  studentId     String
  note          String
  followUpDate  DateTime?
  createdById   String
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  student       Student     @relation(fields: [studentId], references: [id])
}

model ClassTemplate {
  id               String            @id @default(cuid())
  institutionId    String
  name             String
  gradeLevel       Int
  description      String?
  createdAt        DateTime          @default(now())
  institution      Institution       @relation(fields: [institutionId], references: [id])
  classYears       ClassYear[]
  leads            Lead[]
  meritListConfigs MeritListConfig[]

  @@unique([institutionId, name])
}

model ClassYear {
  id                    String                 @id @default(cuid())
  serialNo              Int                    @unique @default(autoincrement())
  institutionId         String
  classTemplateId       String
  academicYearId        String
  status                ClassYearStatus        @default(ACTIVE)
  clonedFromId          String?
  createdAt             DateTime               @default(now())
  academicYear          AcademicYear           @relation(fields: [academicYearId], references: [id])
  classTemplate         ClassTemplate          @relation(fields: [classTemplateId], references: [id])
  institution           Institution            @relation(fields: [institutionId], references: [id])
  examSchedules         ExamSchedule[]
  promotionsFrom        PromotionRecord[]      @relation("FromClassYear")
  promotionsTo          PromotionRecord[]      @relation("ToClassYear")
  reportCardGenerations ReportCardGeneration[]
  sections              Section[]
  studentSections       StudentSection[]
  subjects              Subject[]

  @@unique([classTemplateId, academicYearId])
}

model Section {
  id                      String                   @id @default(cuid())
  institutionId           String
  classYearId             String
  name                    String
  maxStrength             Int?
  classTeacherId          String?
  createdAt               DateTime                 @default(now())
  attendance              Attendance[]
  classTeacherAssignments ClassTeacherAssignment[]
  classYear               ClassYear                @relation(fields: [classYearId], references: [id])
  institution             Institution              @relation(fields: [institutionId], references: [id])
  students                StudentSection[]
  subjects                Subject[]
  substitutions           SubstitutionRecord[]
  timetableSlots          TimetableSlot[]

  @@unique([classYearId, name])
}

model StudentSection {
  id            String               @id @default(cuid())
  institutionId String
  studentId     String
  sectionId     String
  classYearId   String
  enrolledAt    DateTime             @default(now())
  promotedAt    DateTime?
  status        StudentSectionStatus @default(ACTIVE)
  classYear     ClassYear            @relation(fields: [classYearId], references: [id])
  institution   Institution          @relation(fields: [institutionId], references: [id])
  section       Section              @relation(fields: [sectionId], references: [id])
  student       Student              @relation(fields: [studentId], references: [id])

  @@unique([studentId, classYearId])
}

model PromotionRecord {
  id              String          @id @default(cuid())
  institutionId   String
  studentId       String
  fromClassYearId String
  fromSectionId   String
  toClassYearId   String?
  toSectionId     String?
  status          PromotionStatus
  promotedById    String
  promotedAt      DateTime        @default(now())
  notes           String?
  fromClassYear   ClassYear       @relation("FromClassYear", fields: [fromClassYearId], references: [id])
  institution     Institution     @relation(fields: [institutionId], references: [id])
  student         Student         @relation(fields: [studentId], references: [id])
  toClassYear     ClassYear?      @relation("ToClassYear", fields: [toClassYearId], references: [id])
}

model Subject {
  id                        String                      @id @default(cuid())
  serialNo                  Int                         @unique @default(autoincrement())
  institutionId             String
  classYearId               String
  sectionId                 String?
  name                      String
  code                      String?
  weeklyPeriods             Int                         @default(5)
  hasOnlineContent          Boolean                     @default(false)
  canPreviewFiles           Boolean                     @default(true)
  canDownloadFiles          Boolean                     @default(false)
  logo                      String?
  color                     String                      @default("#6366f1")
  description               String?
  enrollmentType            EnrollmentType              @default(AUTO)
  showGradesToStudents      Boolean                     @default(true)
  allowLateSubmission       Boolean                     @default(false)
  completionTrackingEnabled Boolean                     @default(true)
  subjectStartDate          DateTime?
  coTeachers                String[]                    @default([])
  teachingAssistants        String[]                    @default([])
  createdAt                 DateTime                    @default(now())
  examSchedules             ExamSchedule[]
  gradeEntries              GradeEntry[]
  groupSets                 GroupSet[]
  homeworkLogs              HomeworkLog[]
  lessonPlans               LessonPlan[]
  questionBanks             QuestionBank[]
  rubrics                   Rubric[]
  moduleItemProgress        StudentModuleItemProgress[]
  studentNotes              StudentNote[]
  classYear                 ClassYear                   @relation(fields: [classYearId], references: [id])
  institution               Institution                 @relation(fields: [institutionId], references: [id])
  section                   Section?                    @relation(fields: [sectionId], references: [id])
  announcements             SubjectAnnouncement[]
  assignments               SubjectAssignment[]
  certificates              SubjectCertificate[]
  discussions               SubjectDiscussion[]
  exportJobs                SubjectExportJob[]
  gradebookConfig           SubjectGradebookConfig?
  liveClasses               SubjectLiveClass[]
  modules                   SubjectModule[]
  moduleItems               SubjectModuleItem[]         @relation("SubjectModuleItems")
  posts                     SubjectPost[]
  resources                 SubjectResource[]
  teachers                  SubjectTeacher[]
