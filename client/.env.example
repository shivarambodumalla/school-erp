# ─── Database ───
# PostgreSQL connection string (used by Prisma for queries)
DATABASE_URL=postgresql://user:password@localhost:5432/school_erp
# Direct connection URL (used by Prisma for migrations, bypasses connection pooler)
DIRECT_URL=postgresql://user:password@localhost:5432/school_erp

# ─── Authentication (NextAuth v5) ───
# Secret for signing JWT tokens — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Base URL of your app (used for OAuth callbacks, CSRF)
NEXTAUTH_URL=http://localhost:3000

# ─── App URLs ───
# Public-facing URL (used for links in emails, client-side redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cloudinary (file/image uploads) — optional for local dev ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
